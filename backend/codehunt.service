[Unit]
Description=codehunt API server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=codehunt
Group=codehunt
WorkingDirectory=/opt/codehunt
EnvironmentFile=/opt/codehunt/.env
ExecStart=/opt/codehunt/.venv/bin/uvicorn backend.server:app --host 127.0.0.1 --port 8080
Restart=on-failure
RestartSec=5

# Hardening
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/codehunt

[Install]
WantedBy=multi-user.target
