# Required: Gemini key for the default --provider gemini path.
GEMINI_API_KEY=AIza...

# Required: shared secret between this server and the Android app.
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
CODEHUNT_API_TOKEN=replace-me

# Optional: only needed if the app ever sets provider=claude.
# ANTHROPIC_API_KEY=sk-ant-...
